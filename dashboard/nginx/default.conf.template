server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # N469 — hinter dem Cloudflare Tunnel kommt jede Anfrage vom cloudflared-
    # Container (Docker-Netz), nicht von Cloudflares oeffentlichen Adressen.
    # Die echte Besucher-IP steht in CF-Connecting-IP; nur Absendern aus den
    # privaten Docker-Netzen wird dieser Header geglaubt (ein LAN-Client aus
    # 192.168.x koennte ihn sonst faelschen). Damit tragen $remote_addr, das
    # Zugriffslog und das X-Forwarded-For unten die Besucher-IP — die
    # Voraussetzung fuer jede spaetere IP-Bremse in der API.
    set_real_ip_from 172.16.0.0/12;
    set_real_ip_from 10.0.0.0/8;
    real_ip_header CF-Connecting-IP;

    include /etc/nginx/sicherheit.inc;

    location = /healthz { return 200 "ok\n"; add_header Content-Type text/plain; }

    # Build-Kennung des Images. Liegt ausserhalb von html/, weil public/ dort
    # eingehaengt ist -- so bleibt sie trotz Bind-Mount abrufbar.
    location = /build.txt { alias /etc/nginx/build.txt; default_type text/plain; }

    # API-Proxy -> FastAPI (immocalc-api / -dev). Frontend ruft same-origin /api/... auf.
    location /api/ {
        proxy_pass http://${API_UPSTREAM}/api/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        # Belege sind PDFs, oft mehrseitige Scans mit Bildern und OCR-Textschicht
        # — die Vorgabe von 1 MB reicht nicht (Foto-Scanner wie Bestandsimport
        # laufen sonst in 413). Grosszuegig, aber begrenzt.
        client_max_body_size 50m;
        # Manche Vorgaenge lesen viele Belege am Stueck (Bestand neu
        # klassifizieren, voller Abgleich) — die Vorgabe von 60 s reicht nicht,
        # sonst antwortet nginx mit 504, obwohl der Server noch arbeitet.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    # .webmanifest kennt die mitgelieferte mime.types nicht — ohne den
    # richtigen Typ ignorieren Browser das Manifest.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/sicherheit.inc;
    }

    default_type text/plain;
    charset utf-8;
    charset_types text/plain text/css application/javascript text/markdown application/json;

    # N469 #4 — /docs/ (interne Markdown-/Mermaid-Dokumente aus public/docs/)
    # wird nicht mehr ausgeliefert: auf einer Domain waeren das Architektur-
    # und Rechenlogik-Notizen fuer jeden Besucher. Die Dateien bleiben im
    # Repo, nur der Weg ueber den Browser ist zu.
    location /docs/ { return 404; }

    gzip on;
    gzip_types text/plain text/css application/javascript text/markdown image/svg+xml application/json;

    location / { try_files $uri $uri/ =404; }
    # no-store statt no-cache: bei no-cache revalidiert der Browser per ETag und
    # bekommt ein 304 *ohne* Content-Type zurueck -- er behaelt dann den alten,
    # ggf. falschen Typ aus dem Cache und laedt die Seite als Datei herunter.
    location ~* \.html$ {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/sicherheit.inc;
    }
    # CCCXXXVII-Nachtrag: public/ ist live gemountet — Frontend-Aenderungen sind
    # ohne Deploy sofort wirksam. Damit der Browser aber nie einen veralteten
    # (oder waehrend eines Zwischenstands kaputt geladenen) JS-/CSS-Baustein aus
    # dem Cache haelt, werden auch die Assets nicht gespeichert. Kleine Dateien
    # im lokalen Netz -- der Verzicht auf Caching kostet praktisch nichts und
    # macht das Modul-System robust gegen gecachte Fehlstaende.
    location ~* \.(js|mjs|css)$ {
        add_header Cache-Control "no-store" always;
        include /etc/nginx/sicherheit.inc;
    }
}
